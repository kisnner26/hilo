{
  "name": "@hilo/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Hilo: contexto, decisión y formatos para el equipo, con Claude Code y Codex por suscripción.",
  "author": {
    "name": "Hilo",
    "email": "kisnner26@users.noreply.github.com"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hilo/core": "0.1.0",
    "d3-force-3d": "^3.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "edu.uam.hilo",
    "productName": "Hilo",
    "files": [
      "out/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "hilo"
    },
    "extraResources": [
      {
        "from": "../../profiles",
        "to": "profiles"
      }
    ],
    "directories": {
      "output": "release"
    },
    "electronVersion": "39.8.10",
    "publish": [
      {
        "provider": "github",
        "owner": "kisnner26",
        "repo": "hilo"
      }
    ]
  },
  "repository": "https://github.com/kisnner26/hilo",
  "homepage": "https://github.com/kisnner26/hilo"
}
